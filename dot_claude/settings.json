{
  "permissions": {
    "deny": [
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout .)",
      "Bash(git clean -f *)",
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(kill -9 *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(curl *|*sh)",
      "Bash(wget *|*sh)",
      "Bash(open *)",
      "Bash(osascript *)",
      "Bash(defaults write *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(npm publish *)",
      "Bash(yarn publish *)",
      "Bash(pnpm publish *)",
      "Bash(*deploy*)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(docker push *)",
      "Bash(aws * --no-cli-pager)",
      "Bash(gcloud * --quiet)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_schedule_message"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bun x ccusage statusline --no-offline --cost-source both --visual-burn-rate emoji --context-low-threshold 60 --context-medium-threshold 90",
    "padding": 0
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "datadog@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "micronity": {
      "source": {
        "source": "git",
        "url": "https://github.com/metaps/sre-ops-report-skill.git",
        "ref": "feat/plugin-structure"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.config/gcloud",
        "~/.bash_history",
        "~/.zsh_history"
      ]
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "in=$(cat); f=$(printf '%s' \"$in\" | /opt/homebrew/bin/jq -r '.tool_input.file_path // empty'); sid=$(printf '%s' \"$in\" | /opt/homebrew/bin/jq -r '.session_id // \"default\"'); [ -n \"$f\" ] && echo \"$f\" >> \"${TMPDIR:-/tmp}/claude_edits_${sid}.txt\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sid=$(/opt/homebrew/bin/jq -r '.session_id // \"default\"'); list=\"${TMPDIR:-/tmp}/claude_edits_${sid}.txt\"; [ -f \"$list\" ] || exit 0; proc=\"${list}.proc.$$\"; mv \"$list\" \"$proc\" 2>/dev/null || exit 0; if [ -n \"$NVIM\" ] && nvim --server \"$NVIM\" --remote-expr \"v:lua.ClaudeOpenEdited('$proc')\" >/dev/null 2>&1; then :; else rm -f \"$proc\"; fi; exit 0"
          }
        ]
      }
    ]
  }
}
